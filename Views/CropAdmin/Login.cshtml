@{ Layout = "~/Views/Shared/_CropAdminLayout.cshtml"; ViewBag.Title = "Admin login"; }
<section class="login-wrap"><div class="login-art"><span class="eyebrow">THE CROP DATA WORKSPACE</span><h1>Good insights<br />begin with<br />good data.</h1><p>Explore source observations and bring new crop statistics into the atlas.</p><img src="@Url.Content("~/Content/crop-landscape.svg")" alt="Illustrated fields with wheat, maize and cotton" /></div><article class="login-form"><p class="eyebrow">ADMIN ACCESS</p><h2>Welcome back</h2><p class="muted">Sign in to manage crop observations.</p>@using (Html.BeginForm("Login", "CropAdmin", FormMethod.Post)) { @Html.AntiForgeryToken() @Html.ValidationSummary(true, "", new { @class = "notice error" })<input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" /><label>Username<input type="text" name="username" value="@ViewBag.Username" autocomplete="username" required maxlength="80" /></label><label>Password<input type="password" name="password" autocomplete="current-password" required maxlength="255" /></label><button class="button" type="submit">Sign in to workspace</button> }</article></section>

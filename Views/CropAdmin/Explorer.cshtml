@model NADashboard.Controllers.CropExplorer
@{ Layout = "~/Views/Shared/_CropAdminLayout.cshtml"; ViewBag.Title = "Data explorer"; ViewBag.AdminPage = "explorer"; }
<section class="hero"><div><p class="eyebrow">SOURCE OBSERVATIONS</p><h1>Explore the crop data</h1><p>Inspect original reporting areas, measurements and calculated yield.</p></div><a class="button" href="@Url.Action("Import")">+ Import crop data</a></section>
@if (TempData["ImportMessage"] != null) { <p class="notice success" role="status">@TempData["ImportMessage"]</p> }
@using (Html.BeginForm("Explorer", "CropAdmin", FormMethod.Get, new { @class = "filters admin-filters" })) { <label>Crop<select name="crop">@foreach (var crop in Model.Crops) { <option value="@crop.Id" selected="@(crop.Id == Model.CropId)">@crop.Name</option> }</select></label><label>Fiscal year<select name="year"><option value="">All available years</option>@foreach (var year in Model.Years) { <option value="@year" selected="@(year == Model.Year)">@year</option> }</select></label><label>Source district or code<input name="search" value="@Model.Search" placeholder="Name or reporting-area code" maxlength="80" /></label><button class="button" type="submit">Explore</button> }
<section class="admin-summary"><div><strong>@Model.Count.ToString("N0")</strong><span>matching source observations</span></div><div><strong>Production ÷ area</strong><span>yield always calculated from measurements</span></div><div><strong>CropData</strong><span>original district breakdown preserved</span></div></section>
<section class="panel"><div class="panel-heading"><h2>Source records</h2><span class="pill">Page @Model.Page of @Math.Max(1, (Model.Count + 29) / 30)</span></div><div class="table-scroll"><table><thead><tr><th>ID / source district</th><th>Reporting-area code</th><th>Mapped geography</th><th>Fiscal year</th><th>Area</th><th>Production</th><th>Calculated yield</th></tr></thead><tbody>@foreach (var row in Model.Rows) { <tr><td><small class="muted">#@row.Id</small><br /><strong>@row.District</strong></td><td><span class="pill">@row.DistrictCode</span></td><td>@row.DistrictDescription</td><td>@row.FiscalYear</td><td>@(row.Area.HasValue ? row.Area.Value.ToString("N3") : "—")</td><td>@(row.Production.HasValue ? row.Production.Value.ToString("N3") : "—")</td><td>@(row.Yield.HasValue ? row.Yield.Value.ToString("N3") : "—")</td></tr> }@if (!Model.Rows.Any()) { <tr><td colspan="7">No source observations match these filters.</td></tr> }</tbody></table></div><div class="table-footer"><span>Area and production retain their source units.</span>@if (Model.Page > 1) { <a class="quiet" href="@Url.Action("Explorer", new { crop = Model.CropId, year = Model.Year, search = Model.Search, page = Model.Page - 1 })">Previous</a> }@if (Model.Page * 30 < Model.Count) { <a class="quiet" href="@Url.Action("Explorer", new { crop = Model.CropId, year = Model.Year, search = Model.Search, page = Model.Page + 1 })">Next</a> }</div></section>

@model NADashboard.Controllers.CropImport
@{ Layout = "~/Views/Shared/_CropAdminLayout.cshtml"; ViewBag.Title = "Import crop data"; ViewBag.AdminPage = "import"; }
<section class="hero"><div><p class="eyebrow">GROW THE DATA COLLECTION</p><h1>Bring your crop data in</h1><p>Select a crop, upload its observations, then review before saving.</p></div><a class="quiet" href="@Url.Action("Template")">Download CSV template</a></section>
<div class="import-steps"><span class="active">01 · Select & upload</span><span class="@(Model.Token != null ? "active" : "")">02 · Review observations</span><span>03 · Import observations</span></div>
@if (TempData["ImportMessage"] != null) { <p class="notice" role="status">@TempData["ImportMessage"]</p> }
@if (Model.Errors.Any()) { <div class="notice error" role="alert"><strong>Please correct the following:</strong><ul>@foreach (var error in Model.Errors) { <li>@error</li> }</ul></div> }
<section class="grid import-grid"><article class="panel"><div class="panel-heading"><h2>Select a crop & CSV file</h2></div>@using (Html.BeginForm("Preview", "CropAdmin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "upload-form" })) { @Html.AntiForgeryToken()<label>Crop<select name="crop" required><option value="">Choose a crop</option>@foreach (var crop in Model.Crops) { <option value="@crop.Id" selected="@(crop.Id == Model.CropId)">@crop.Name</option> }</select></label><label class="upload-zone">Upload observations<input name="file" type="file" accept=".csv,text/csv" required /><small>CSV · up to 4 MB · up to 5,000 rows</small></label><button class="button" type="submit">Validate & preview</button> }</article><article class="panel import-guide"><p class="eyebrow">READY TO IMPORT</p><h2>A simple, consistent format</h2><p>Use the template headers:</p><code>District, dist_code, fiscalyear, Area, Production</code><ul><li>Choose the crop above; every row belongs to that crop.</li><li>Keep the original source district or subdivision name.</li><li>Use district codes or combined codes 990, 991 and 992.</li><li>Use fiscal years such as 2025-26.</li><li>Use source-scale values. Blank measurements remain missing.</li><li>Yield is calculated; do not supply a Yield column.</li><li>Existing crop / year / code / source-district keys are rejected.</li></ul><p>New records are added together in one transaction. Existing observations are preserved.</p></article></section>
@if (Model.Token != null && !Model.Errors.Any()) { <section class="panel"><div class="panel-heading"><div><p class="eyebrow">VALIDATION PASSED</p><h2>@Model.Rows.Count.ToString("N0") observations ready to import</h2></div><span class="pill">@Model.Crops.First(c => c.Id == Model.CropId).Name</span></div><div class="table-scroll"><table><thead><tr><th>Source district</th><th>Code</th><th>Fiscal year</th><th>Area</th><th>Production</th><th>Calculated yield</th></tr></thead><tbody>@foreach (var row in Model.Rows.Take(50)) { <tr><td>@row.District</td><td>@row.DistrictCode</td><td>@row.FiscalYear</td><td>@row.Area</td><td>@row.Production</td><td>@(row.Yield.HasValue ? row.Yield.Value.ToString("N3") : "—")</td></tr> }</tbody></table></div><div class="import-confirm"><p>Showing the first @Math.Min(50, Model.Rows.Count) rows. Saving imports all @Model.Rows.Count validated rows. This preview expires after 20 minutes.</p>@using (Html.BeginForm("Commit", "CropAdmin", FormMethod.Post)) { @Html.AntiForgeryToken()<input type="hidden" name="token" value="@Model.Token" /><button type="submit" class="button">Import @Model.Rows.Count observations</button> }</div></section> }

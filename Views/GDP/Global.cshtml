@{

    <link rel="stylesheet" href="~/Content/flag-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/1.1.1/css/bootstrap-multiselect.css">

    <style>

        .chart {
            height: 500px;
            border: solid 1px grey;
            border-radius: 10px;
            margin-top: 1px;
        }

        .navbar-nav li, .navbar-brand {
            padding-left: 10px;
            padding-right: 10px;
            background-color: rgba(0, 128, 128, 0.9);
            margin: 3px;
            border-radius: 5px;
            border: solid 1px lightgreen;
        }

        .fi {
            font-size: 20px;
        }

        .map-value {
            font-size: 16px;
        }
    </style>
}


<main>
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div style="position:relative; height:415px">
                    <img src="~/Content/images/pakecon.png" style="width:100%; height:410px; position:absolute; right:0px; left:0px; " />
                    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark">
                        <div class="container-fluid">
                            @Html.ActionLink("Global", "Global", "GDP", new { area = "" }, new { @class = "navbar-brand" })
                            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                                    aria-expanded="false" aria-label="Toggle navigation">
                                <span class="navbar-toggler-icon"></span>
                            </button>
                            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                                <ul class="navbar-nav flex-grow-1" style="font-weight:bold;">
                                    <li>@Html.ActionLink("GDP", "Index", "GDP", new { area = "" }, new { @class = "nav-link" })</li>
                                    <li>@Html.ActionLink("Tax", "Index", "Tax", new { area = "" }, new { @class = "nav-link" })</li>
                                    <li>@Html.ActionLink("Agriculture", "Home", "Crops", new { area = "" }, new { @class = "nav-link" })</li>
                                </ul>
                            </div>
                        </div>
                    </nav>
                    <img src="~/Content/images/logo.png" style="width:200px; height:auto; position:absolute; left:5px; top:60px;" />
                    <div style="z-index: 1; position: absolute; right: 5px; left: 5px; padding: 2px 10px; bottom: 20px; background: linear-gradient(to right, teal, #808080); opacity: 80%; border-radius: 5px; ">
                        <h2 style="color:white; font-weight:bold;">Gross Domestic Product (Global Comparison)</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-6 rp" style="margin-bottom:7px;">
                <div class="partition">
                    <div style="float:left;">
                        <select id="output">
                            <option value="Nominal">GDP (Current)</option>
                            <option value="Position">Rank</option>
                            <option value="Change">change</option>
                            <option value="Share">share (%)</option>
                        </select>
                        <select id="wview">
                            <option value="1">World Map</option>
                            <option value="2">Globe View</option>
                        </select>
                        <select id="year">
                            <option value="0">Overall</option>
                        </select>
                    </div>
                    <div style="clear:both;" class="chart" id="map"></div>
                </div>
            </div>
            <div class="col-lg-6 rp" style="margin-bottom:7px;">
                <div class="partition">
                    <span>.</span>
                    <div style="clear:both;" class="chart" id="chart4"></div>
                </div>
            </div>

        </div>
        <div class="row">
            <div class="col-lg-12 rp" style="margin-bottom:7px;">
                <div class="partition">
                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-toggle" type="button" id="countriesBtn" data-bs-toggle="dropdown" aria-expanded="false">
                            Select countries
                        </button>
                        <ul class="dropdown-menu p-3" aria-labelledby="countriesBtn" style="max-height:250px; overflow-y:auto;">
                            <li><div class="form-check"><input class="form-check-input country" type="checkbox" value="pk" id="pk"><label class="form-check-label" for="pk">Pakistan</label></div></li>
                            <li><div class="form-check"><input class="form-check-input country" type="checkbox" value="in" id="in"><label class="form-check-label" for="in">India</label></div></li>
                            <li><div class="form-check"><input class="form-check-input country" type="checkbox" value="us" id="us"><label class="form-check-label" for="us">United States</label></div></li>
                            <li><div class="form-check"><input class="form-check-input country" type="checkbox" value="uk" id="uk"><label class="form-check-label" for="uk">United Kingdom</label></div></li>
                            <li><div class="form-check"><input class="form-check-input country" type="checkbox" value="cn" id="cn"><label class="form-check-label" for="cn">China</label></div></li>
                            <li><div class="form-check"><input class="form-check-input country" type="checkbox" value="jp" id="jp"><label class="form-check-label" for="jp">Japan</label></div></li>
                        </ul>
                    </div>
                    <div style="clear:both;" class="chart" id="table"></div>
                </div>
            </div>
        </div>
    </div>
</main>







@section scripts{
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.highcharts.com/maps/highmaps.js"></script>
    <script src="https://code.highcharts.com/highcharts-3d.js"></script>
    <script src="https://code.highcharts.com/modules/sunburst.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>
    <script src="https://code.highcharts.com/modules/export-data.js"></script>
    <script src="https://code.highcharts.com/modules/accessibility.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/1.1.1/js/bootstrap-multiselect.min.js"></script>

    <script>
        $(document).ready(function () {
            var CDATA = [];
            var C3DATA = [];
            var C4DATA = [];
            $('#countries').multiselect({
                includeSelectAllOption: true,
                enableFiltering: true,
                nonSelectedText: 'Select countries',
                buttonWidth: '300px',
                maxHeight: 250
            });
            $.get("/GDP/getWorldYear/", function (response) {
                var years = response.data;
                var str = "";
                years.forEach(function (item) {
                    str += `<option value="${item.value}">${item.value}</option>`;
                });
                $("#year").html(str);
                GetWorldMap();
            });



            $("#wview").on("change", function () {
                SetWorldMap();
            });

            $("#year").on("change", function () {
                GetWorldMap();
            });
            $("#output").on("change", function () {
                GetWorldMap();
            });

            function GetWorldMap() {
                var y = $("#year").val();
                var o = $("#output").val();
                $.get("/GDP/GetWorldGDP/?year=" + y + "&output=" + o, function (response) {
                    C3DATA = response.data;
                    SetWorldMap();
                    var d = { "cc": "AS", "c2": "PK", "c3": "PAK", "iso": "586", "name": "Pakistan", "year": "2024", "value": 373071855731.5387 };
                    SetChart4Line(d, "Pakistan", 'green');
                });
            }


            function SetWorldMap() {
                var data = C3DATA;

                var output = $("#output").val();
                var view = null;
                var v = $("#wview").val();
                if (v == 2) {
                    view = {
                        projection: {
                            name: 'Orthographic',
                            rotation: [-45, 0]
                        }
                    };
                }

                var min = Math.min(...data.map(item => item.value));
                var max = Math.max(...data.map(item => item.value));
                var step = Math.round((max / 1000)) * 100;
                const totalValue = data.reduce((sum, point) => sum + (point.value || 0), 0);
                var colorLegend = {
                    dataClasses: [{
                        to: step / 10,
                        color: '#a6d8a6'  // very light green
                    }, {
                        from: step / 10,
                        to: step / 5,
                        color: '#6cc66c'  // medium light green
                    }, {
                        from: step / 5,
                        to: step / 2,
                        color: '#3ca63c'  // medium green
                    }, {
                        from: step / 2,
                        to: step,
                        color: '#2a7d2a'  // darker green
                    }, {
                        from: step,
                        color: '#1b4d1b'  // darkest green
                    }]
                };


                if (output == "Change") {
                    colorLegend = {
                        dataClasses: [{
                            to: 0,
                            color: 'red'
                        }, {
                            from: 0,
                            to: 3,
                            color: '#55cd74'
                        }, {
                            from: 3,
                            to: 6,
                            color: '#17b741'
                        }, {
                            from: 6,
                            to: 10,
                            color: '#11874f'
                        },
                        {
                            from: 10,
                            color: '#044526'
                        }]
                    };
                }
                else if (output == "Share") {
                    colorLegend = {
                        dataClasses: [{
                            to: 0.25,
                            color: '#8B0000'
                        }, {
                            from: 0.25,
                            to: 0.5,
                            color: '#DC143C'
                        }, {
                            from: 0.50,
                            to: 0.75,
                            color: '#FF4500'
                        }, {
                            from: 0.75,
                            to: 1,
                            color: '#FF6347'
                        },
                        {
                            from: 1,
                            color: '#FF7F7F'
                        }]
                    };
                }
                else if (output == "Position") {
                    colorLegend = {
                        dataClasses: [{
                            to: 10,
                            color: '#8B0000'
                        }, {
                            from: 10,
                            to: 25,
                            color: '#DC143C'
                        }, {
                            from: 25,
                            to: 50,
                            color: '#FF4500'
                        }, {
                            from: 50,
                            to: 100,
                            color: '#FF6347'
                        },
                        {
                            from: 100,
                            color: '#FF7F7F'
                        }]
                    };
                }
                (async () => {

                    const topology = await fetch(
                        '/scripts/js/json/world.topo.json'
                    ).then(response => response.json());


                    // Prevent logarithmic errors in color calulcation

                    // Initialize the chart
                    Highcharts.mapChart('map', {

                        chart: {
                            map: topology
                        },

                        mapNavigation: {
                            enabled: true,
                            enableButtons: true, // enables the zoom in/out buttons
                            buttonOptions: {
                                align: 'right',
                                verticalAlign: 'bottom'
                            }
                        },
                        title: {
                            text: 'World Map of GDP [' + data[0].year + '] [GDP ' + output.toUpperCase() + '] [Current Price] '
                        },
                        subtitle: {
                            text: 'click any country to see historic time series'
                        },
                        legend: {
                            title: {
                                text: null,
                                style: {
                                    color: ( // theme
                                        Highcharts.defaultOptions &&
                                        Highcharts.defaultOptions.legend &&
                                        Highcharts.defaultOptions.legend.title &&
                                        Highcharts.defaultOptions.legend.title.style &&
                                        Highcharts.defaultOptions.legend.title.style.color
                                    ) || 'black',
                                    fontSize: '16px',   // increase title font size here if you have title text
                                    fontWeight: 'bold'
                                }
                            },
                            align: 'left',
                            verticalAlign: 'bottom',
                            floating: true,
                            layout: 'vertical',
                            valueDecimals: (colorLegend.dataClasses[0].to < 1 ? 1 : 0),
                            backgroundColor: ( // theme
                                Highcharts.defaultOptions &&
                                Highcharts.defaultOptions.legend &&
                                Highcharts.defaultOptions.legend.backgroundColor
                            ) || 'rgba(255, 255, 255, 0.85)',
                            symbolRadius: 0,
                            symbolHeight: 14,
                            itemStyle: {       // <--- Add this
                                fontSize: '14px',
                                fontWeight: 'normal',
                                color: 'black'
                            }
                        },

                        credits: {
                            useHTML: true,
                            text: "<p style='color:black; font-size:12px;'>Source: <a href='https://data.worldbank.org/indicator/NY.GDP.MKTP.CD?view=map' target='_blank'>World Bank</a>,  Credit: <a style='color:green; font-weight:bold; font-size:11px' href='http://www.pbs.gov.pk'>pbs.gov.pk</a></p>"
                        },
                        mapView: view,

                        tooltip: {
                            backgroundColor: 'none',
                            borderWidth: 0,
                            shadow: false,
                            useHTML: true,
                            padding: 0,
                            formatter: function () {
                                const totalValue = this.series.data.reduce((sum, p) => sum + (p.value || 0), 0);
                                const percentage = totalValue ? ((this.point.value / totalValue) * 100).toFixed(2) : 0;
                                return `<span class="map-title"><b>${this.point.name}</b></span><br>
                                                                                                                    <span class="fi fi-${this.point.properties['hc-key']}" <br></span>
                                                                                                                    <span class="map-value">${this.point.value}</span>`;
                            },
                            positioner: function () {
                                return { x: 5, y: 150 };
                            }
                        },

                        colorAxis: colorLegend,

                        series: [{
                            data: data,
                            joinBy: ['iso-a3', 'c3'],
                            name: output,
                            point: {
                                events: {
                                    click: function () {
                                        SetChart4Line(this.options, this.name, this.color);
                                    }
                                }
                            }
                        }]
                    });

                })();

            }

            function SetChart4Line(country, name, color) {
                $('#cview option[value=1]').prop('selected', true);
                var output = $('#output').val();
                $.get("/GDP/GetWorldGDP/?year=0&c3=" + country.c3 + "&output=" + output, function (response) {
                    CDATA = response.data;
                    Highcharts.chart('chart4', {
                        chart: {
                            type: 'areaspline'
                        },
                        title: {
                            useHTML: true,
                            text: '<span>GDP ' + output + ' [' + name + '] <span style = "font-size:10" class= "fi fi-' + country.c2.toLowerCase() + '" > </span></span> '
                        },
                        subtitle: {
                            text: 'Source: <a href="https://data.worldbank.org/indicator/NY.GDP.MKTP.CD?view=map" target="_blank">World Bank Data</a>',
                            style: {
                                fontSize: '11px'
                            }
                        },

                        credits: {
                            useHTML: true,
                            text: "<p style='color:black; font-size:12px;'>Source: <a href='https://data.worldbank.org/indicator/NY.GDP.MKTP.CD?view=map' target='_blank'>World Bank</a>,  Credit: <a style='color:green; font-weight:bold; font-size:11px' href='http://www.pbs.gov.pk'>pbs.gov.pk</a></p>"
                        },
                        plotOptions: {
                            column: {
                                depth: 25
                            }
                        },
                        xAxis: {
                            categories: CDATA.map(obj => obj.year)
                        },
                        yAxis: {
                            title: {
                                text: 'value'
                            }
                        },
                        plotOptions: {
                            column: {
                                pointPadding: 0.2,
                                borderWidth: 0
                            }
                        },
                        series: [
                            {
                                name: "GDP " + output,
                                data: CDATA.map(obj => obj.value),
                                color: color
                            }
                        ]
                    });
                });



            }
        });
    </script>

}

@{
    ViewBag.Title = "Home Page";

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

    <style>
        .input-group-addon {
            width: 80px;
            background-color: green;
            color: white;
            border-top-left-radius: 5px;
            border-bottom-left-radius: 5px;
            text-align: center;
            padding-top: 7px;
            font-size: 14px;
            font-weight: bold;
        }
        .partition{
            margin-top:15px;
        }
        .ntb {
            margin-bottom: 2px;
            border:solid 1px grey;
            border-radius:4px;
            font-size:16px;
        }
        .ntb.active {
            background-color: blue;
            color: white;
        }
        .form-select {
            border-color: green;
        }

        .navbar-nav li, .navbar-brand {
            padding-left: 10px;
            padding-right: 10px;
            background-color: rgba(0, 128, 128, 0.9);
            margin: 3px;
            border-radius: 5px;
            border: solid 1px lightgreen;
        }

        tr.bg-primary {
            background-color: black !important;
            color: white;
        }

        .icon-cell {
            text-align: center;
            font-size: 20px;
        }

        #mytable th:nth-child(3), #mytable td:nth-child(3) {
            display: none;
        }

        .chart {
            height: 350px;
            border: solid 1px grey;
            border-radius: 10px;
            margin-top: 15px;
        }
    </style>

}

<main>
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div style="position:relative; height:415px">
                    <img src="~/Content/images/pakecon.png" style="width:100%; height:410px; position:absolute; right:0px; left:0px; " />
                    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark">
                        <div class="container-fluid">
                            @Html.ActionLink("GDP", "Index", "GDP", new { area = "" }, new { @class = "navbar-brand" })
                            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                                    aria-expanded="false" aria-label="Toggle navigation">
                                <span class="navbar-toggler-icon"></span>
                            </button>
                            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                                <ul class="navbar-nav flex-grow-1" style="font-weight:bold;">
                                    <li>@Html.ActionLink("QNA", "QNA", "GDP", new { area = "" }, new { @class = "nav-link" })</li>
                                    <li>@Html.ActionLink("Global", "Global", "GDP", new { area = "" }, new { @class = "nav-link" })</li>
                                    <li>@Html.ActionLink("Tax", "Index", "Tax", new { area = "" }, new { @class = "nav-link" })</li>
                                    <li>@Html.ActionLink("Agriculture", "Home", "Crops", new { area = "" }, new { @class = "nav-link" })</li>
                                </ul>
                            </div>
                        </div>
                    </nav>
                    <img src="~/Content/images/logo.png" style="width:200px; height:auto; position:absolute; left:5px; top:60px;" />
                    <div style="z-index: 1; position: absolute; right: 5px; left: 5px; padding: 2px 10px; bottom: 20px; background: linear-gradient(to right, teal, #808080); opacity: 80%; border-radius: 5px; ">
                        <h2 style="color:white; font-weight:bold;">Gross Domestic Product of Pakistan</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12 rp" style="margin-bottom:7px;">
                <div class="partition">
                    <div style="float:left;">
                        <span style="font-size:16px; color:black; font-weight:bold;">Gross Domest Product (GDP) Overview</span>
                    </div>
                    <div style="float:right;">
                        <div id="output" style="float:right;">
                            <button type="button" class="ntb active" data-id="GDP">GDP</button>
                            <button type="button" class="ntb" data-id="Agriculture">Agriculture</button>
                            <button type="button" class="ntb" data-id="Industry">Industry</button>
                            <button type="button" class="ntb" data-id="Service">Service</button>
                            <button type="button" class="ntb" data-id="Subsidies">Subsidies</button>
                            <button type="button" class="ntb" data-id="Taxes">Taxes</button>
                        </div>
                    </div>
                    <div style="clear:both;" class="chart" id="chart1"></div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="chart" id="chart2"></div>
            </div>
            <div class="col-lg-8">
                <div class="chart" id="chart21"></div>
            </div>
            <div class="col-lg-4">
                <div style="position:relative;">
                    <div class="chart" id="erchart"></div>
                </div>
            </div>
            <div class="col-lg-4">
                <div style="position:relative;">
                    <div class="chart" id="npichart"></div>
                </div>
            </div>
            <div class="col-lg-4">
                <div style="position:relative;">
                    <div class="chart" id="pcichart"></div>
                </div>
            </div>
            <div class="col-lg-12 rp" style="margin-bottom:7px;">
                <div class="partition">
                    <div style="float:left;">
                        <span style="font-size:16px; color:black; font-weight:bold;">Historical Trend of Sectoral / GDP Growth</span>
                    </div>
                    <div style="float:right;">
                        <div id="bands" style="float:right;">
                            <button type="button" class="ntb active" data-id="1">Growth Bands</button>
                            <button type="button" class="ntb" data-id="2">Govt Bands</button>
                        </div>
                    </div>
                    <div style="clear:both;" class="chart" id="scatterchart"></div>
                </div>
            </div>


        </div>
        <div class="col-lg-12">
            <div style="position:relative; margin-top:15px;">
                <span style="font-size:16px; color:black; font-weight:bold;">GDP Heat Table</span>
                <div style="position:absolute; right:0px; top:0px;">
                    <select id="heattype">
                        <option value="row">Row  Heat Table</option>
                        <option value="column">Column Heat Table</option>
                    </select>
                    <select id="heatvalue">
                        <option value="share">Share</option>
                        <option value="change">YoY Change (%)</option>
                        <option value="contribution">Contribution</option>
                    </select>
                </div>
                <div style="margin-top:15px;" id="mytable">
                </div>
            </div>
        </div>
    </div>
</main>


<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="https://code.highcharts.com/highcharts.js"></script>
<script src="https://code.highcharts.com/highcharts-3d.js"></script>
<script src="https://code.highcharts.com/modules/sunburst.js"></script>
<script src="https://code.highcharts.com/modules/exporting.js"></script>
<script src="https://code.highcharts.com/modules/export-data.js"></script>
<script src="https://code.highcharts.com/modules/accessibility.js"></script>
<script>
    $(document).ready(function () {
        getGDP();
        OUTPUT = [];
        GDPDATA = [];
        DATA = [];
        const ICONS = {
            // Major Sectors
            "Agriculture": "fa-leaf",
            "Industry": "fa-cogs",
            "Service": "fa-briefcase",

            // Agriculture Subsectors
            "Crops": "fa-seedling",
            "Fishing": "fa-fish",
            "Forestry": "fa-tree",
            "Livestock": "fa-paw",

            // Industry Subsectors
            "Construction": "fa-tools",
            "Electricity, gas and water": "fa-bolt",
            "Manufacturing": "fa-industry",
            "Mining & Quarrying": "fa-hammer",

            // Services Subsectors
            "Hotels & Restaurants": "fa-utensils",
            "Education": "fa-graduation-cap",
            "Finance & Insurance Activities": "fa-chart-line",
            "Human Health and Social Work": "fa-user-nurse",
            "Information and Communication": "fa-wifi",
            "Other Private Services": "fa-box",
            "General Government": "fa-landmark",
            "Real Estate (Ownership)": "fa-building",
            "Transport& Storage": "fa-truck",
            "Wholesale & Retail Trade": "fa-ship"
        };

        $("#output .ntb").on('click', function () {
            $('#output .ntb').removeClass("active");
            $(this).addClass("active");
            getGDP();
            var output = $(this).attr('data-id');
            if (output == 'Agriculture' || output == 'Service' || output == 'Industry') {
                displayArea(output);
            }
            else {
                displayArea(null);
            }
        });
        getBreakdown();
        function getGDP() {
            var output = $('#output .ntb.active').attr('data-id');
            $.get("/GDP/getGDP/?months=12&currency=pkr&price=constant&output=" + output + "&year=0", function (result) {
                timeseries(result.data, output);
            });
        }

        function getBreakdown() {
            var output = $('#output .ntb.active').attr('data-id');
            $.get("/GDP/getGDPbreakdown/?months=12&currency=pkr&price=constant&output=" + output + "&year=0", function (result) {
                DATA = response = result.data;
                displayPie(response[response.length - 1].year);
                OUTPUT = buildGDPHierarchy(response);
                displayArea(null);
                displayTable();
            });
        }

        getLines('current', 'Exchange%20Rate', 'erchart');
        getLines('constant', 'NPI', 'npichart');
        getLines('constant', 'Per%20Capita%20Income', 'pcichart');
        function getLines(price, output, id) {
            $.get("/GDP/getGDPbreakdown/?months=12&currency=pkr&price=" + price + "&output=" + output + "&year=0", function (result) {
                var response = result.data;
                displayLines(response, id);
            });
        }

        function displayLines(data, id) {
            data.sort((a, b) => a.year - b.year);

            // Extract years and values arrays
            const years = data.map(d => d.year);
            const values = data.map(d => d.value);

            // Calculate % change wrt previous year
            const changes = values.map((val, i, arr) => {
                if (i === 0) return null; // no previous year
                if (val === null || arr[i - 1] === null) return null;
                return parseFloat((((val - arr[i - 1]) / arr[i - 1]) * 100).toFixed(2));
            });

            Highcharts.chart(id, {
                chart: {
                    zoomType: 'xy',
                    type: 'line'
                },
                title: {
                    text: data[0].sector
                },
                xAxis: {
                    categories: years,
                    crosshair: true,
                    title: {
                        text: 'Year'
                    }
                },
                yAxis: [
                    { // Primary yAxis for Value
                        labels: {
                            format: '{value}',
                            style: {
                                color: Highcharts.getOptions().colors[0]
                            }
                        },
                        title: {
                            text: 'Value',
                            style: {
                                color: Highcharts.getOptions().colors[0]
                            }
                        },
                        opposite: false
                    },
                    { // Secondary yAxis for Percentage Change
                        title: {
                            text: 'Percentage Change (%)',
                            style: {
                                color: Highcharts.getOptions().colors[1]
                            }
                        },
                        labels: {
                            format: '{value}%',
                            style: {
                                color: Highcharts.getOptions().colors[1]
                            }
                        },
                        opposite: true,
                        min: Math.min(...changes.filter(c => c !== null)) * 1.2, // a little padding below min
                        max: Math.max(...changes.filter(c => c !== null)) * 1.2  // padding above max
                    }
                ],
                tooltip: {
                    shared: true,
                    valueDecimals: 2,
                    formatter: function () {
                        let s = `<b>Year: ${this.x}</b>`;
                        this.points.forEach(point => {
                            s += `<br/><span style="color:${point.color}">\u25CF</span> ${point.series.name}: <b>${point.y !== null ? (point.series.name === '% Change' ? point.y + '%' : point.y) : 'N/A'}</b>`;
                        });
                        return s;
                    }
                },
                legend: {
                    layout: 'horizontal',
                    align: 'center',
                    verticalAlign: 'bottom'
                },
                series: [{
                    name: 'Value',
                    data: values,
                    yAxis: 0,
                    tooltip: {
                        valueSuffix: ''
                    }
                }, {
                    name: '% Change',
                    data: changes,
                    visible: false,
                    yAxis: 1,
                    tooltip: {
                        valueSuffix: '%'
                    }
                }]
            });
        }




        function timeseries(data, title) {
            // Step 1: Compute growth values
            let growth = data.map((x, i) => {
                if (i === 0) return null; // No growth for first year
                let prev = +data[i - 1].value;
                let curr = +x.value;
                if (prev === 0) return null;
                return +(((curr - prev) / prev) * 100).toFixed(2); // % growth
            });

            Highcharts.chart('chart1', {
                chart: {
                    zoomType: 'xy' // allow zoom for both axes
                },
                credits: {
                    useHTML: true,
                    text: "<p style='color:black; font-size:12px;'>Source: National Accounts, PBS,  Credit: <a style='color:green; font-weight:bold; font-size:11px' href='http://www.pbs.gov.pk'>pbs.gov.pk</a></p>"
                },
                title: {
                    text: 'Gross Domestic Product - ' + title
                },

                subtitle: {
                    text: 'Click any bar (to change pie chart)',
                },
                exporting: {
                    buttons: {
                        contextButton: {
                            menuItems: ["downloadPNG", "downloadJPEG", "downloadPDF", "downloadXLS"]
                        }
                    }
                },
                xAxis: {
                    categories: data.map(x => x.year),
                    crosshair: true,
                    plotBands: [
                        {
                            from: data.findIndex(x => String(x.year).includes('2019')) + 0.5,
                            to: data.findIndex(x => String(x.year).includes('2020')) + 0.5,
                            color: 'rgba(255, 192, 203, 0.3)', // light pink
                            label: {
                                text: 'COVID',
                                style: {
                                    color: '#FF3366',
                                    fontWeight: 'bold'
                                }
                            }
                        },
                        {
                            from: data.findIndex(x => String(x.year).includes('2022')) + 0.5, // halfway into 2020
                            to: data.findIndex(x => String(x.year).includes('2023')) + 0.5,   // slightly past 2020
                            color: 'rgba(200, 200, 200, 0.3)', // light grey with 30% opacity
                            label: {
                                text: 'NCM',
                                style: {
                                    color: '#FF3366',
                                    fontWeight: 'bold'
                                }
                            }
                        },
                        {
                            from: data.findIndex(x => String(x.year).includes('2008')), // halfway into 2020
                            to: data.findIndex(x => String(x.year).includes('2009')) + 0.5,   // slightly past 2020
                            color: 'rgba(205, 133, 63, 0.2)', // brownish
                            label: {
                                text: 'Crises',
                                style: {
                                    color: '#FF3366',
                                    fontWeight: 'bold'
                                }
                            }
                        }
                    ]
                },
                yAxis: [
                    { // Primary yAxis (GDP)
                        title: {
                            text: 'Trillion PKR',
                            style: {
                                fontWeight: 'bold',
                                fontSize: '12px'
                            }
                        },
                        opposite: false
                    },
                    { // Secondary yAxis (Growth %)
                        title: {
                            text: 'Growth (%)',
                            style: {
                                fontWeight: 'bold',
                                fontSize: '12px'
                            }
                        },
                        labels: {
                            format: '{value}%',
                        },
                        opposite: true
                    }
                ],
                tooltip: {
                    shared: true,
                    headerFormat: '<span style="font-size:12px"><b>{point.key}</b></span><br>'
                },
                plotOptions: {
                    line: {
                        dataLabels: {
                            enabled: true
                        },
                    },
                    column: {
                        point: {
                            events: {
                                click: function () {
                                    displayPie(this.category); // this.name holds the category name
                                }
                            }
                        }
                    }
                },
                series: [
                    {
                        type: 'column',
                        color: 'green',
                        name: title,
                        yAxis: 0,
                        data: data.map(x => +(x.value / 1000000.0).toFixed(2)) // Convert to trillion PKR
                    },
                    {
                        type: 'line',
                        name: 'Growth (%)',
                        color: 'red',
                        yAxis: 1,
                        data: growth,
                        marker: {
                            enabled: true
                        },
                        tooltip: {
                            valueSuffix: '%'
                        }
                    }
                ]
            });
        }


        function displayPie(year) {
            const sectorTotals = {};

            $.each(DATA, function (index, item) {
                if (item.year === year) {
                    if (!sectorTotals[item.sector]) {
                        sectorTotals[item.sector] = 0;
                    }
                    sectorTotals[item.sector] += item.value;
                }
            });
            //let color = { Agriculture: "orange", Industry: "rgb(84,79,197)", Service: "rgb(0,226,114)" };
            // Step 2: Convert to array and pick top 3 (or just 3 if no sorting needed)
            const result = Object.keys(sectorTotals).map(sector => {
                return { name: sector, y: sectorTotals[sector] };
            });
            const sortedResult = result.sort((a, b) => b.y - a.y);


            Highcharts.chart('chart2', {
                chart: {
                    type: 'pie',
                    options3d: {
                        enabled: true,
                        alpha: 45
                    },

                    events: {
                        load: function () {
                            const chart = this;
                            document.addEventListener('click', function (e) {
                                const isSlice = e.target.closest('.highcharts-point');
                                if (!isSlice && e.target.closest('#chart2')) {
                                    displayArea(null);
                                }
                            });
                        }
                    }
                },
                title: {
                    text: 'GDP Share FY' + year,
                },
                subtitle: {
                    text: 'click any sector (to change area chart)',
                },
                credits: {
                    useHTML: true,
                    text: "<p style='color:black; font-size:12px;'>Source: National Accounts, PBS, Credit: <a style='color:green; font-weight:bold; font-size:11px' href='http://www.pbs.gov.pk'>pbs.gov.pk</a></p>"
                },
                plotOptions: {
                    pie: {
                        allowPointSelect: true,
                        cursor: 'pointer',
                        innerSize: 60,
                        depth: 45,
                        dataLabels: {
                            enabled: true,
                            format: '<b>{point.name}</b><br>{point.percentage:.1f}%',
                            distance: 20
                        },
                        showInLegend: false,
                        point: {
                            events: {
                                click: function () {
                                    displayArea(this.name); // this.name holds the category name
                                }
                            }
                        }
                    }
                },
                series: [{
                    name: 'GDP By Sector',
                    data: sortedResult // each item must have a 'name' and 'y' value
                }]
            });
        }





        function buildGDPHierarchy(data) {
            const years = [...new Set(data.map(d => d.year))].sort();
            const yearTotalMap = {}; // total GDP by year
            const sectorMap = {};

            // 1. Calculate total GDP per year
            for (const year of years) {
                yearTotalMap[year] = data
                    .filter(d => d.year === year)
                    .reduce((sum, d) => sum + d.value, 0);
            }

            // 2. Group data into sector > subsector > year
            for (const item of data) {
                const { sector, subsector, year, value } = item;

                if (!sectorMap[sector]) {
                    sectorMap[sector] = { sector, years: {}, subsectors: {} };
                }

                // Sector total per year
                sectorMap[sector].years[year] = (sectorMap[sector].years[year] || 0) + value;

                // Subsector total per year
                if (!sectorMap[sector].subsectors[subsector]) {
                    sectorMap[sector].subsectors[subsector] = { name: subsector, years: {} };
                }
                sectorMap[sector].subsectors[subsector].years[year] =
                    (sectorMap[sector].subsectors[subsector].years[year] || 0) + value;
            }

            // 3. Convert to final structured array
            const output = [];

            for (const sectorName in sectorMap) {
                const sectorObj = sectorMap[sectorName];
                const sectorArea = [];
                const sectorYears = sectorObj.years;

                // Build sector area with share and change
                for (const year of years) {
                    const value = sectorYears[year] || 0;
                    const share = +(value / yearTotalMap[year] * 100).toFixed(2);
                    sectorArea.push({ year, value, share, change: null, contribution:null });
                }

                // Add change %
                for (let i = 1; i < sectorArea.length; i++) {
                    const curr = sectorArea[i];
                    const prev = sectorArea[i - 1];
                    if (prev.value > 0) {
                        curr.change = +(((curr.value - prev.value) / prev.value) * 100).toFixed(2);
                    }
                    curr.contribution = +((curr.change * curr.share) / 100);
                }

                // Subsector processing
                const subsectors = [];

                for (const subName in sectorObj.subsectors) {
                    const subObj = sectorObj.subsectors[subName];
                    const subArea = [];

                    for (const year of years) {
                        const value = subObj.years[year] || 0;
                        const share = +(value / yearTotalMap[year] * 100).toFixed(2);
                        subArea.push({ year, value, share, change: null, contribution:null });
                    }

                    for (let i = 1; i < subArea.length; i++) {
                        const curr = subArea[i];
                        const prev = subArea[i - 1];
                        if (prev.value > 0) {
                            curr.change = +(((curr.value - prev.value) / prev.value) * 100).toFixed(2);
                        }

                        curr.contribution = +((curr.change * curr.share) / 100);
                    }

                    subsectors.push({ name: subName, data: subArea });
                }

                output.push({
                    name: sectorName,
                    data: sectorArea,
                    subsectors
                });
            }

            return output;
        }



        function displayArea(s) {
            let series;
            if (s != null) {
                const sector = OUTPUT.find(item => item.name === s);
                series = sector.subsectors
                    // Step 1: sort by total share (or average share)
                    .slice() // avoid mutating original
                    .sort((a, b) => {
                        const totalA = a.data.reduce((sum, item) => sum + item.share, 0);
                        const totalB = b.data.reduce((sum, item) => sum + item.share, 0);
                        return totalB - totalA; // ascending: smaller on top
                    })
                    // Step 2: map to Highcharts format
                    .map(set => ({
                        name: set.name,
                        data: set.data.map(item => [item.year, item.share])
                    }));
            }
            else {
                series = OUTPUT
                    // Step 1: sort by total share (or average share)
                    .slice() // avoid mutating original
                    .sort((a, b) => {
                        const totalA = a.data.reduce((sum, item) => sum + item.share, 0);
                        const totalB = b.data.reduce((sum, item) => sum + item.share, 0);
                        return totalB - totalA; // ascending: smaller on top
                    })
                    // Step 2: map to Highcharts format
                    .map(set => ({
                        name: set.name,
                        data: set.data.map(item => [item.year, item.share])
                    }));
            }



            // Step 4: Draw area chart
            Highcharts.chart('chart21', {
                chart: {
                    type: 'area'
                },
                title: {
                    text: 'Historic Series of Sectorial Share (% of GDP)'
                },
                xAxis: {
                    title: { text: 'Year' },
                    allowDecimals: false
                },
                yAxis: {
                    title: {
                        text: 'Percentage Share'
                    },
                    labels: {
                        format: '{value}%'
                    }
                },
                tooltip: {
                    pointFormat: '{series.name}: <b>{point.y:.1f}%</b><br/>',
                    shared: true
                },
                plotOptions: {
                    area: {
                        marker: {
                            enabled: false
                        }
                    }
                },
                legend: {
                    layout: 'vertical',
                    align: 'left',
                    verticalAlign: 'middle',
                    floating: false,
                    borderWidth: 1,
                    backgroundColor: '#ffffff',
                    itemMarginTop: 5,
                    itemMarginBottom: 5
                },
                credits: {
                    useHTML: true,
                    text: "<p style='color:black; font-size:12px;'>Source: National Accounts, PBS, Credit: <a style='color:green; font-weight:bold; font-size:11px' href='http://www.pbs.gov.pk'>pbs.gov.pk</a></p>"
                },
                series: series
            });
        }




        function breakdown(dataset, year) {
            Highcharts.chart('chart4', {

                chart: {
                    height: '100%'
                },

                credits: {
                    useHTML: true,
                    text: "<p style='color:black; font-size:12px;'>Soruce: National Accounts, PBS,  Credit: <a style='color:green; font-weight:bold; font-size:11px' href='http://www.pbs.gov.pk'>pbs.gov.pk</a></p>"
                },
                // Let the center circle be transparent
                colors: ['transparent'].concat(Highcharts.getOptions().colors),

                title: {
                    text: 'GDP Distribution FY' + year
                },

                series: [{
                    type: 'sunburst',
                    data: dataset,
                    name: 'Root',
                    allowDrillToNode: true,
                    borderRadius: 3,
                    cursor: 'pointer',
                    dataLabels: {
                        format: '{point.name}',
                        filter: {
                            property: 'innerArcLength',
                            operator: '>',
                            value: 16
                        }
                    },
                    levels: [{
                        level: 1,
                        levelIsConstant: false,
                        dataLabels: {
                            filter: {
                                property: 'outerArcLength',
                                operator: '>',
                                value: 64
                            }
                        }
                    }, {
                        level: 2,
                        colorByPoint: true
                    },
                    {
                        level: 3,
                        colorVariation: {
                            key: 'brightness',
                            to: -0.5
                        }
                    }, {
                        level: 4,
                        colorVariation: {
                            key: 'brightness',
                            to: 0.5
                        }
                    }]

                }],

                tooltip: {
                    headerFormat: '',
                    pointFormat: 'The GDP of <b>{point.name}</b> is <b>{point.value}</b>'
                }
            });
        }

        function linechart(data) {
            Highcharts.chart('chart3', {
                chart: {
                    type: 'line'
                },
                title: {
                    text: 'Per Capita Income'
                },
                credits: {
                    useHTML: true,
                    text: "<p style='color:black; font-size:12px;'>Soruce: National Accounts, PBS,  Credit: <a style='color:green; font-weight:bold; font-size:11px' href='http://www.pbs.gov.pk'>pbs.gov.pk</a></p>"
                },
                xAxis: {
                    categories: data.map(x => x.Year.substring(0, 4))
                },
                yAxis: {
                    title: {
                        text: 'Thousand PKR'
                    }
                },
                plotOptions: {
                    line: {
                        dataLabels: {
                            enabled: true
                        },
                        enableMouseTracking: false
                    }
                },
                series: [{
                    name: 'Avg Income',
                    data: data.map(x => +(x.PCI / 1000).toFixed(2))
                }]
            });
        }

        function displayTable(field = 'share') {
            const output = OUTPUT;
            const flatOutput = OUTPUT;
            const allYearsSet = new Set();

            flatOutput.forEach(sector => {
                sector.data.forEach(d => allYearsSet.add(d.year));
                sector.subsectors.forEach(sub => {
                    sub.data.forEach(d => allYearsSet.add(d.year));
                });
            });

            const allYears = Array.from(allYearsSet).sort();

            const rows = [];

            flatOutput.forEach(sector => {
                // Sector row
                const sectorYearMap = {};
                sector.data.forEach(d => {
                    // use dynamic field or fallback to null if not present
                    sectorYearMap[d.year] = (d[field] !== undefined) ? d[field] : null;
                });
                const sectorValues = allYears.map(year => sectorYearMap[year] ?? null);
                rows.push({ name: sector.name, shares: sectorValues, isSubsector: false });

                // Subsectors rows
                sector.subsectors.forEach(sub => {
                    const subYearMap = {};
                    sub.data.forEach(d => {
                        subYearMap[d.year] = (d[field] !== undefined) ? d[field] : null;
                    });
                    const subValues = allYears.map(year => subYearMap[year] ?? null);
                    rows.push({ name: sub.name, shares: subValues, isSubsector: true });
                });
            });
            const $table = renderTable(allYears, rows);
            $('#mytable').empty().append($table);
            applyHeatmap($('#mytable'), { orientation: $("#heattype").val() });
        }


        $("#heattype").on('change', function () {
            applyHeatmap($('#mytable'), { orientation: $(this).val() });
        });
        $("#heatvalue").on('change', function () {
            displayTable($(this).val());
        });
        function renderTable(allYears, rows) {
            // Create table elements
            const $table = $('<table class="table table-bordered">').attr({ border: 1, cellpadding: 5, cellspacing: 0 }).css('border-collapse', 'collapse');
            const $thead = $('<thead>');
            const $tbody = $('<tbody>');

            // Header row
            const $headerRow = $('<tr  class="bg-primary">');
            $headerRow.append($('<th>').text('Icon'));
            $headerRow.append($('<th>').text('Sector'));
            allYears.forEach(year => {
                $headerRow.append($('<th>').text(year));
            });
            $thead.append($headerRow);

            // Data rows
            rows.forEach(row => {
                const $tr = $('<tr>');
                const randomColor = '#' + Math.floor(Math.random() * 16777215).toString(16);
                $tr.append(`<td class="icon-cell"><i class="fas ${ICONS[row.name]}" style="color:${randomColor};"></i></td>`);

                //$tr.append($('<td>').text(ICONS[row.name]));
                const $nameTd = $('<td>').text(row.name)
                    .css('padding-left', row.isSubsector ? '20px' : '5px')
                    .css('font-weight', row.isSubsector ? 'normal' : 'bold');
                $tr.append($nameTd);

                row.shares.forEach(share => {
                    let val = share !== null ? share.toFixed(2) : '-';
                    $tr.append($('<td>').text(val));
                });

                $tbody.append($tr);
            });

            $table.append($thead, $tbody);
            return $table;
        }



        function applyHeatmap($table, options = { orientation: 'row', colorMin: '#ffffff', colorMax: '#007700' }) {
            const { orientation, colorMin, colorMax } = options;

            function interpolateColor(min, max, value) {
                if (value === 0 || value === null || value === undefined) {
                    return '#ffffff';
                }
                const clamp = (num, minVal, maxVal) => Math.min(Math.max(num, minVal), maxVal);
                const hexToRgb = hex => {
                    if (typeof hex !== 'string') return [255, 255, 255]; // default white
                    if (hex.startsWith('#')) hex = hex.slice(1);
                    if (hex.length === 3) hex = hex.split('').map(c => c + c).join('');
                    const result = hex.match(/\w\w/g);
                    return result ? result.map(x => parseInt(x, 16)) : [255, 255, 255];
                };

                const rgbToHex = rgb => '#' + rgb.map(x => x.toString(16).padStart(2, '0')).join('');

                const mixColors = (color1, color2, factor) => {
                    const c1 = hexToRgb(color1);
                    const c2 = hexToRgb(color2);
                    const result = c1.map((c, i) => Math.round(c + factor * (c2[i] - c)));
                    return rgbToHex(result);
                };

                if (value === 0 || value === null || value === undefined) {
                    return '#ffffff';
                }

                if (value > 0) {
                    if (max <= min) {
                        return '#007700';
                    }
                    const factor = clamp((value - min) / (max - min), 0, 1);
                    return mixColors('#ffffff', '#007700', factor);
                } else if (value < 0) {
                    if (min >= max) {
                        return '#ff0000';
                    }
                    const factor = clamp((value - max) / (min - max), 0, 1);
                    return mixColors('#ffffff', '#ff0000', factor);
                }
            }



            function getContrastYIQ(hexColor) {
                if (hexColor.startsWith('#')) hexColor = hexColor.slice(1);
                if (hexColor.length === 3) hexColor = hexColor.split('').map(c => c + c).join('');
                if (hexColor.length !== 6) return '#000000';
                const r = parseInt(hexColor.substr(0, 2), 16);
                const g = parseInt(hexColor.substr(2, 2), 16);
                const b = parseInt(hexColor.substr(4, 2), 16);
                const yiq = (r * 299 + g * 587 + b * 114) / 1000;
                return yiq >= 128 ? '#000000' : '#ffffff';
            }

            function parseCellValue($cell) {
                const text = $cell.text().replace(/,/g, '').trim();
                const num = parseFloat(text);
                return isNaN(num) ? null : num;
            }

            if (orientation === 'row') {
                // Iterate each row (skip header row if present)
                $table.find('tbody tr').each(function () {
                    const $cells = $(this).find('td').not(':first'); // assuming first column is label
                    const values = [];

                    $cells.each(function () {
                        values.push(parseCellValue($(this)));
                    });

                    // Filter valid numbers
                    const validValues = values.filter(v => v !== null);
                    if (validValues.length === 0) return; // skip if no valid numbers

                    const min = Math.min(...validValues);
                    const max = Math.max(...validValues);

                    $cells.each(function (i) {
                        const val = values[i];
                        if (val === null) {
                            $(this).css('background-color', '');
                            return;
                        }
                        const bgColor = interpolateColor(min, max, val);
                        const textColor = getContrastYIQ(bgColor);
                        $(this).css({ 'background-color': bgColor, 'color': textColor });
                    });
                });
            } else if (orientation === 'column') {
                // Iterate each column (skip first column if it’s label)
                const $rows = $table.find('tbody tr');
                const colCount = $rows.first().find('td').length;

                for (let colIndex = 1; colIndex < colCount; colIndex++) { // assuming first col label
                    const values = [];
                    $rows.each(function () {
                        const $cell = $(this).find('td').eq(colIndex);
                        values.push(parseCellValue($cell));
                    });

                    const validValues = values.filter(v => v !== null);
                    if (validValues.length === 0) continue;

                    const min = Math.min(...validValues);
                    const max = Math.max(...validValues);

                    $rows.each(function (rowIndex) {
                        const val = values[rowIndex];
                        const $cell = $(this).find('td').eq(colIndex);
                        if (val === null) {
                            $cell.css('background-color', '');
                            return;
                        }
                        const bgColor = interpolateColor(min, max, val);
                        const textColor = getContrastYIQ(bgColor);
                        $cell.css({ 'background-color': bgColor, 'color': textColor });
                    });
                }
            } else {
                console.warn('Invalid orientation option. Use "row" or "column".');
            }
        }
        getGrowth();
        function getGrowth() {
            $.get("/GDP/getGrowth/?months=12&currency=pkr&price=constant&from=0&to=0", function (result) {
                GDPDATA = result.data;
                displayScatterPlot();
            });
        }

        $("#bands .ntb").on('click', function () {
            $('#bands .ntb').removeClass("active");
            $(this).addClass("active");
            displayScatterPlot();
        });
        function displayScatterPlot() {
            var gdpData = GDPDATA;
            var band = $("#bands .ntb.active").attr("data-id");
            var showXAxisBands = false;
            if (band == 2) {
                showXAxisBands = true;
            }
            const categories = gdpData.map(d => d.Year);
            const agriData = gdpData.map(d => d.Agriculture);
            const industryData = gdpData.map(d => d.Industry);
            const serviceData = gdpData.map(d => d.Service);
            const gdp = gdpData.map(d => d.GDP);

            const govtColors = {
                'PPP': 'rgba(128, 128, 128, 0.1)',
                'PMLN': 'rgba(0, 128, 0, 0.1)',
                'PTI': 'rgba(255, 0, 0, 0.1)',
                'Military': 'rgba(255, 165, 0, 0.1)',
                'Other': 'rgba(128, 128, 128, 0.1)'
            };

            let xAxisPlotBands = [];
            if (showXAxisBands) {
                let currentGovt = gdpData[0].Govt;
                let fromIndex = 0;

                for (let i = 1; i <= gdpData.length; i++) {
                    if (i === gdpData.length || gdpData[i].Govt !== currentGovt) {
                        xAxisPlotBands.push({
                            from: fromIndex - 0.5,
                            to: i - 0.5,
                            color: govtColors[currentGovt] || 'rgba(200,200,200,0.1)', // fallback color
                            label: {
                                align: 'center',
                                verticalAlign: 'top',
                                text: currentGovt, y: 0,
                                style: { color: '#333' }
                            }
                        });
                        if (i < gdpData.length) {
                            currentGovt = gdpData[i].Govt;
                            fromIndex = i;
                        }
                    }
                }
            }

            let yAxisPlotBands = [];
            if (!showXAxisBands) {
                yAxisPlotBands = [
                    {
                        from: -20,
                        to: 0,
                        color: 'rgba(255, 0, 0, 0.1)',
                        label: { text: 'Negative', align: 'left', style: { color: '#333' } }
                    },
                    {
                        from: 0,
                        to: 6,
                        color: 'rgba(255, 255, 0, 0.1)',
                        label: { text: 'Growth', align: 'left', style: { color: '#333' } }
                    },
                    {
                        from: 6,
                        to: 30,
                        color: 'rgba(0, 255, 0, 0.1)',
                        label: { text: 'High', align: 'left', style: { color: '#333' } }
                    }
                ];
            }

            Highcharts.chart('scatterchart', {
                chart: {
                    type: 'line'
                },
                title: {
                    text: 'Sector Growth Over the Years'
                },
                xAxis: {
                    categories: categories,
                    title: null,
                    plotBands: xAxisPlotBands
                },
                yAxis: {
                    title: { text: 'Value' },
                    tickInterval: 3,
                    plotBands: yAxisPlotBands
                },
                tooltip: {
                    shared: true
                },
                plotOptions: {
                    series: {
                        lineWidth: 0,
                        marker: {
                            enabled: true,
                            symbol: 'circle',
                            radius: 5
                        }
                    }
                },
                series: [
                    { name: 'Agriculture', data: agriData, color: 'springgreen' },
                    { name: 'Industry', data: industryData, color: 'red' },
                    { name: 'Service', data: serviceData, color: 'deepskyblue' },
                    { name: 'Total GDP', data: gdp, color: 'black', visible: false }
                ]
            });
        }



    });


</script>
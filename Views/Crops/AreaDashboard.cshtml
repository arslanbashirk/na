@{
    Layout = null;
    var level = (string)ViewBag.AreaLevel;
    var label = level == "province" ? "Province" : level == "division" ? "Division" : "District";
}
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@label profile &middot; Pakistan Crop Statistics</title>
<link rel="stylesheet" href="@Url.Content("~/Scripts/vendor/leaflet/leaflet.css")" /><link rel="stylesheet" href="@Url.Content("~/Content/crop-atlas.css")" /><link rel="stylesheet" href="@Url.Content("~/Content/crop-theme.css")" /><link rel="stylesheet" href="@Url.Content("~/Content/crop-editorial.css")" /><link rel="stylesheet" href="@Url.Content("~/Content/crop-shell.css")" /><link rel="stylesheet" href="@Url.Content("~/Content/crop-imagery.css")" /></head>
<body id="page-top" class="crop-shell area-dashboard" data-page="area" data-level="@level" data-api="@Url.Action("Explore", "Crops")" data-root="@Url.Content("~/")" style="--page-harvest-image: url('@Url.Content("~/Content/images/pakistan-area-profile-banner.png")')">
@Html.Partial("_CropNavigation")
<main class="workspace" id="main-content">
<button id="menu-toggle" class="shell-icon-button dashboard-menu-toggle" type="button" aria-label="Open navigation" aria-controls="crop-navigation" aria-expanded="false"><svg class="shell-icon" aria-hidden="true"><use href="@Url.Content("~/Content/crop-icons.svg#shell-menu")"></use></svg></button>
<section class="hero harvest-hero"><img class="harvest-photo" src="@Url.Content("~/Content/images/pakistan-area-profile-banner.png")" alt="Pakistan's irrigated agricultural landscape" fetchpriority="high" /><div class="hero-copy"><p class="eyebrow">AREA PROFILE &middot; @label.ToUpper()S</p><h1>Every crop.<br />One place.</h1><p class="hero-deck">The complete picture of your region's harvest.</p><p id="intro">Explore what grows here, how production changes, and how each crop's yield progresses.</p><div class="hero-tags"><span>Crop composition</span><span>Production history</span><span>Yield progress</span></div></div><div class="hero-stamp"><small>ALL REPORTED CROPS</small><span id="hero-year">&mdash;</span><small>FISCAL YEAR</small></div></section>
<nav class="section-nav" aria-label="Page sections"><a href="#profile-section">What grows here</a><a href="#trends-section">Progress over time</a><a href="#map-section">Explore the area</a><a href="#data-section">Crop detail</a></nav>
<section class="filters" aria-label="Area profile filters"><label>@label<select id="area" aria-label="Select @label.ToLower()"></select></label><label>Fiscal year<select id="year"></select></label><button id="reset" class="quiet" type="button">Reset</button></section>
<div id="status" role="status" aria-live="polite">Loading area observations...</div>
<section class="context"><svg class="selected-crop-icon" aria-hidden="true"><use href="@Url.Content("~/Content/crop-icons.svg#location")"></use></svg><h2 id="selection">@label profile</h2><span class="pill">All crops</span></section>
<section id="cards" class="cards" aria-label="Area indicators"></section><section id="insights" class="insights" aria-label="Area insights"></section>
<section id="profile-section" class="grid area-profile-grid"><article class="panel"><div class="panel-heading"><div><p class="eyebrow">THE CULTIVATION MIX</p><h2>What grows here</h2></div></div><div class="area-chart-scroll"><div id="portfolio-chart" class="chart tall"></div></div><p class="panel-note">All reported crops, ranked by cultivation area in source units. Summed crop area does not represent unique land.</p></article><article class="panel"><div class="panel-heading"><div><p class="eyebrow">THIS YEAR'S HARVEST</p><h2>Production by crop</h2></div></div><div id="production-crops" class="production-crops"></div><p class="panel-note">Each crop retains its reported production units. Values across different crops are not combined.</p></article></section>
<section id="trends-section" class="grid"><article class="panel"><div class="panel-heading"><div><p class="eyebrow">PRODUCTION PROGRESS</p><h2>How the harvest changes</h2></div></div><div id="trend-chart" class="chart tall"></div><p class="panel-note">Each crop starts at 100 in its first complete, positive observation. The eight crops with the most reported area are shown; gaps remain gaps.</p></article><article class="panel"><div class="panel-heading"><div><p class="eyebrow">YIELD PROGRESS</p><h2>Productivity over time</h2></div></div><div id="yield-chart" class="chart tall"></div><p class="panel-note">Yield = production / area for each crop. Each series starts at 100 in its first valid, positive year. Missing inputs, incomplete records, or zero area have no yield value.</p></article></section>
<section class="panel heat-panel" id="yield-section"><div class="panel-heading"><div><p class="eyebrow">THE PATTERN OF PROGRESS</p><h2 id="heat-title">Yield progress at a glance</h2></div><div class="heat-metrics" role="group" aria-label="Heat table measurement"><button type="button" data-heat-metric="Yield" aria-pressed="true"><svg class="shell-icon" aria-hidden="true"><use href="@Url.Content("~/Content/crop-icons.svg#productivity")"></use></svg>Yield</button><button type="button" data-heat-metric="Production" aria-pressed="false"><svg class="shell-icon" aria-hidden="true"><use href="@Url.Content("~/Content/crop-icons.svg#shell-bars")"></use></svg>Production</button><button type="button" data-heat-metric="Area" aria-pressed="false"><svg class="shell-icon" aria-hidden="true"><use href="@Url.Content("~/Content/crop-icons.svg#field")"></use></svg>Area</button></div></div><div class="heat-toolbar"><div id="heat-range" role="status" aria-live="polite"></div><div class="heat-options"><label>Year span<select id="heat-years"><option value="5">Last 5 years</option><option value="8" selected>Last 8 years</option><option value="10">Last 10 years</option><option value="15">Last 15 years</option><option value="all">All available years</option></select></label><label>Color scale<select id="heat-scale"><option value="table">Across the table</option><option value="row">Within each crop</option><option value="column">Within each year</option></select></label></div></div><div class="heat-key"><span>Decline</span><i aria-hidden="true"></i><span>Increase</span><span class="heat-key-zero">0% &middot; unchanged</span><span class="heat-key-missing">&mdash; No comparison</span></div><div class="table-scroll heat-scroll" id="yield-progress" tabindex="0" role="region" aria-label="Crop progress heat table"></div><p class="panel-note" id="heat-note"></p></section>
<section id="map-section" class="grid map-grid"><article class="panel map-panel"><div class="panel-heading"><div><p class="eyebrow">THE REGIONAL FOOTPRINT</p><h2>Crop diversity across the area</h2></div></div><div id="map" aria-label="Area crop diversity map"></div><div class="map-foot"><span id="map-description">Color shows the number of crops reported in each area.</span><div id="legend"></div></div></article><aside class="panel map-stats-panel"><div class="panel-heading"><div><p class="eyebrow">VALUES ON THE MAP</p><h2>Quick map stats</h2></div></div><div class="map-stats-context" id="map-stats-context"></div><div id="map-stats" class="map-stats-list"></div></aside></section>
<section id="data-section" class="panel"><div class="panel-heading"><div><p class="eyebrow">THE COMPLETE CROP PICTURE</p><h2>Crop detail</h2></div><div class="table-tools"><input type="search" id="search" placeholder="Find a crop..." aria-label="Find a crop" /><button id="table-download" class="button" type="button">Download CSV</button></div></div><div class="table-scroll"><table id="data-table"><thead><tr><th scope="col">Crop</th><th scope="col">Area</th><th scope="col">Production</th><th scope="col">Yield</th><th scope="col">Production YoY</th><th scope="col">Yield YoY</th><th scope="col">Incomplete records</th></tr></thead><tbody></tbody></table></div><div class="table-footer"><span id="table-count"></span><span>Reported source units &middot; all crops</span></div></section>
@Html.Partial("_CropFooter")
</main><script src="@Url.Content("~/Scripts/vendor/leaflet/leaflet.js")"></script><script src="@Url.Content("~/Scripts/vendor/highcharts/highcharts.js")"></script><script src="@Url.Content("~/Scripts/vendor/highcharts/accessibility.js")"></script><script src="@Url.Content("~/Scripts/crop-shell.js")"></script><script src="@Url.Content("~/Scripts/crop-category-icons.js")"></script><script src="@Url.Content("~/Scripts/crop-area.js")"></script></body></html>

        function addValuetoMap(data, att) {
            if (att == 'Production') {
                $.each(data, function (index, value) {
                    data[index].value = data[index].production;
                });
            }
            else if (att == 'Area') {
                $.each(data, function (index, value) {
                    data[index].value = data[index].area;
                });
            }
            else if (att == 'Yield') {
                $.each(data, function (index, value) {
                    data[index].value = data[index].yield;
                });
            }
            return data;
        }

        function decideLegend(data) {
            var gaps = { gap: [0, 10, 50, 100, 200], unit: '', series:'', quantity:'' };
            if (data != null) {
                var min = Math.floor(Math.min(...data.map(d => d.value)));
                var max = Math.ceil(Math.max(...data.map(d => d.value)));
                const steps = 4;
                var stepSize = Math.ceil((max - min) / steps);
                //alert("min=" + min + ", max=" + max + ", step=" + stepSize);
                stepSize = applyBase(stepSize);
                gaps.unit = applyUnit(stepSize);
                if (gaps.unit == 'K') {
                    stepSize = stepSize / 1000;
                }
                else if (gaps.unit == 'M') {
                    stepSize = stepSize / 1000000;
                }
                for (var i = 1; i <= 4; i++) {
                    gaps.gap[i] = gaps.gap[i - 1] + stepSize;
                }

                gaps.series = $("#att").val();
                if (gaps.series == "Production") {
                    gaps.quantity = gaps.unit + ' MT';
                }
                else if (gaps.series == "Area") {
                    gaps.quantity = gaps.unit + ' Hectare';
                }
                else if (gaps.series == "Yield") {
                    gaps.quantity = gaps.unit + '';
                }
            }
            return gaps;
        }

        function decideWorldLegend() {
            var gaps = { gap: [0, 10, 50, 100, 200, 500], unit: '' };
            if (CD3 != null) {
                var min = Math.floor(Math.min(...CD3.map(d => d.value)));
                var max = Math.ceil(Math.max(...CD3.map(d => d.value)));
                const steps = 25;
                var stepSize = Math.ceil((max - min) / steps);
                //alert("min=" + min + ", max=" + max + ", step=" + stepSize);
                stepSize = applyBase(stepSize);
                gaps.unit = applyUnit(stepSize);
                if (gaps.unit == 'K') {
                    stepSize = stepSize / 1000;
                }
                else if (gaps.unit == 'M') {
                    stepSize = stepSize / 1000000;
                }
                for (var i = 1; i <= 5; i++) {
                    gaps.gap[i] = gaps.gap[i - 1] + (stepSize*i);
                }


                var from, to;

                for (var i = 1; i <gaps.gap.length; i++) {
                    from = gaps.gap[i-1];
                    to = gaps.gap[i];

                    WCOLOR[i].from = from;
                    WCOLOR[i].to = to;
                }
                WCOLOR[6].from = to++;
            }
            return gaps;
        }

        function applyBase(num) {

            if (num > 100000) {
                return num - (num % 100000);
            }
            else if (num > 10000) {
                return num - (num % 10000);
            }
            else if (num > 1000) {
                return num - (num % 1000);
            }
            else if (num > 100) {
                return num - (num % 100);
            }
            if (num > 10) {
                return num - (num % 10);
            }
            else {
                return num;
            }
        }

        function applyUnit(num) {
            if (num > 1000000) {
                return 'M';
            }
            else if (num > 1000) {
                return 'K';
            }
            else {
                return '';
            }
        }


